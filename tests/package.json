{
  "name": "dressme-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "npm --prefix ../web ci && npm --prefix ../web run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "serve": "14.2.6"
  },
  "overrides": {
    "compression": "1.8.2",
    "fast-uri": "3.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
