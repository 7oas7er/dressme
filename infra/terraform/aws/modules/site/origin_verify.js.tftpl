function handler(event) {
  var request = event.request;
  var headers = request.headers;
  var allowed = ${jsonencode(origin_verify_secrets)};
  var provided = headers["x-origin-verify"] ? headers["x-origin-verify"].value : null;
  var ok = false;

  if (provided) {
    for (var i = 0; i < allowed.length; i++) {
      if (provided === allowed[i]) {
        ok = true;
        break;
      }
    }
  }

  if (!ok) {
    return {
      statusCode: 403,
      statusDescription: "Forbidden",
      headers: {
        "content-type": { value: "text/plain" }
      },
      body: "Forbidden"
    };
  }

  return request;
}
