function handler(event) {
  var request = event.request;
  var headers = request.headers;
  var allowed = ${jsonencode(origin_verify_secrets)};
  var provided = headers["x-origin-verify"] ? headers["x-origin-verify"].value : null;
  var ok = false;

  if (provided) {
    for (var i = 0; i < allowed.length; i++) {
      if (provided === allowed[i]) {
        ok = true;
        break;
      }
    }
  }

  if (!ok) {
    return {
      statusCode: 403,
      statusDescription: "Forbidden",
      headers: {
        "content-type": { value: "text/plain" }
      },
      body: "Forbidden"
    };
  }

  // CloudFront OAC (signing_behavior=always) overwrites Authorization with SigV4
  // for Lambda Function URL origins. Preserve the Cognito ID token on x-id-token
  // so the API Lambda can still verify the viewer JWT.
  var auth = headers["authorization"] ? headers["authorization"].value : null;
  if (auth && !headers["x-id-token"]) {
    var bearerPrefix = "bearer ";
    var value = auth;
    if (auth.length > bearerPrefix.length && auth.substring(0, bearerPrefix.length).toLowerCase() === bearerPrefix) {
      value = auth.substring(bearerPrefix.length).replace(/^\s+/, "");
    }
    headers["x-id-token"] = { value: value };
  }

  return request;
}
